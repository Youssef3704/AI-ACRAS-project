# Copy to .env locally and use a new key if a previous key was exposed.
ACRAS_API_KEY=
ACRAS_BASE_URL=https://acras.iav.ch/api
DATABASE_URL=postgresql://acras:acras@localhost:5432/acras
ACRAS_DATA_DIR=./data

# Zone for flight/weather. The project station is fixed to ACRAS2-8.
ACRAS_ZONE_ID=
ACRAS_STATION_NAME=ACRAS2-8

# Config reads exported values; it does not automatically load this file.
# Optional disposable integration-test database (never a production database):
# ACRAS_TEST_DATABASE_URL=postgresql://acras:acras@localhost:5432/acras
